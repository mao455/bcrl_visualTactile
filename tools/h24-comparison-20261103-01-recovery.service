[Unit]
Description=H24 comparison recovery with preserved frozen workers
StartLimitIntervalSec=86400
StartLimitBurst=2

[Service]
Type=simple
WorkingDirectory=%h/docs/bc+rl_RSS_native_v2
ExecStart=/usr/bin/bash %h/docs/bc+rl_RSS_native_v2/visuotactile/run_cpu.sh -m tools.h24_runtime_recovery run --root %h/docs/bc+rl_RSS/outputs/visuotactile/native_dp_v2/h24_parameterization_20261103_01
StandardOutput=append:%h/docs/bc+rl_RSS/outputs/visuotactile/native_dp_v2/h24_parameterization_20261103_01/runtime_recovery_01/owner.log
StandardError=inherit
Restart=on-abnormal
RestartSec=5
KillMode=mixed
TimeoutStopSec=90
CPUWeight=10
IOWeight=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
