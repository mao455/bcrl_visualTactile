[Unit]
Description=Recoverable H24 Sample Epsilon comparison
StartLimitIntervalSec=86400
StartLimitBurst=2

[Service]
Type=simple
WorkingDirectory=%h/docs/bc+rl_RSS_native_v2
ExecStart=/usr/bin/bash %h/docs/bc+rl_RSS_native_v2/tools/run_h24_comparison.sh %h/docs/bc+rl_RSS/outputs/visuotactile/native_dp_v2/h24_parameterization_20261103_01
StandardOutput=append:%h/docs/bc+rl_RSS/outputs/visuotactile/native_dp_v2/h24_parameterization_20261103_01/owner.log
StandardError=inherit
Restart=on-abnormal
RestartSec=5
KillMode=mixed
TimeoutStopSec=90
CPUWeight=10
IOWeight=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
