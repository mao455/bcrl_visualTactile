[Unit]
Description=CPU-only postprocessing of offline State/Image isolated evaluations

[Service]
Type=simple
WorkingDirectory=%h/docs/bc+rl_RSS_native_v2
ExecStart=/usr/bin/bash %h/docs/bc+rl_RSS_native_v2/visuotactile/run_cpu.sh -m tools.state_image_analysis --root %h/docs/bc+rl_RSS/outputs/visuotactile/native_dp_v2/state_image_20261104_02 --wait --publish
StandardOutput=append:%h/docs/bc+rl_RSS/outputs/visuotactile/native_dp_v2/state_image_20261104_02/analysis.log
StandardError=inherit
Restart=no
KillMode=control-group
CPUWeight=10
IOWeight=10
